PORT=3001
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhuangxiu
DB_PASSWORD=change-me
DB_NAME=zhuangxiu

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

TEST_LOGIN_PASSWORD=

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

FEATURE_INSPECTION_KB=false

# Redis is required for SMS anti-abuse in production.
REDIS_URL=redis://127.0.0.1:6379
SMS_RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false

# Aliyun SMS settings
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=
