PORT=3001
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhuangxiu
DB_PASSWORD=change-me
DB_NAME=zhuangxiu

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

TEST_LOGIN_PASSWORD=

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# File storage. Keep "local" until OSS is fully configured and verified.
STORAGE_DRIVER=local
OSS_REGION=oss-rg-china-mainland
OSS_BUCKET=yinnkhome666
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional explicit OSS endpoint.
OSS_ENDPOINT=https://oss-rg-china-mainland.aliyuncs.com
OSS_CACHE_CONTROL=private, max-age=1800
OSS_SIGNED_URL_EXPIRES=1800
OSS_REQUEST_TIMEOUT_MS=300000
OSS_MULTIPART_THRESHOLD=5242880
OSS_MULTIPART_PART_SIZE=1048576
OSS_MULTIPART_PARALLEL=1
OSS_MIGRATION_CONCURRENCY=1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

FEATURE_INSPECTION_KB=false

# WeChat Mini Program login
WECHAT_MINIPROGRAM_APPID=
WECHAT_MINIPROGRAM_SECRET=

# Redis is required for SMS anti-abuse in production.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1500
SMS_RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false

# Aliyun SMS settings
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=

# Tianditu Web service key for backend location search.
TIANDITU_WEB_SERVICE_KEY=
